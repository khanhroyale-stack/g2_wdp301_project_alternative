      "html": "<link data-kid=\"1\" data-name=\"stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\">\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap');\n\n  :root {\n    --color-moss: #2A5A3B;\n    --color-terracotta: #E07A5F;\n    --color-sage: #F4F9F5;\n    --color-warm-white: #FDFDFD;\n    --color-slate: #1B2623;\n  }\n\n  body {\n    font-family: 'Be Vietnam Pro', sans-serif;\n    color: var(--color-slate);\n    background-color: var(--color-sage);\n    margin: 0;\n  }\n\n  .zebra-row:nth-child(even) {\n    background-color: #FAFAF8;\n  }\n\n  .status-dot {\n    width: 6px;\n    height: 6px;\n    border-radius: 9999px;\n    display: inline-block;\n  }\n\n  /* Custom animation for organic feel */\n  @keyframes leaf-float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-5px); }\n  }\n  .animate-leaf {\n    animation: leaf-float 4s ease-in-out infinite;\n  }\n</style>\n<div class=\"flex min-h-screen\" data-kid=\"2\" data-name=\"page layout container\">\n\n<aside class=\"w-72 bg-[var(--color-warm-white)] border-r border-[var(--color-moss)]/10 flex flex-col p-8 fixed h-full z-10\" data-kid=\"2-1\" data-name=\"sidebar navigation\">\n<div class=\"flex items-center gap-3 mb-12\" data-kid=\"2-1-1\" data-name=\"brand logo and name container\">\n<div class=\"w-10 h-10 bg-[var(--color-moss)] rounded-xl flex items-center justify-center text-white\" data-kid=\"2-1-1-1\" data-name=\"brand logo icon container\">\n<i class=\"ti ti-leaf text-2xl\" data-kid=\"2-1-1-1-1\" data-name=\"leaf icon\"></i>\n</div>\n<span class=\"text-xl font-black tracking-tight\" data-kid=\"2-1-1-2\" data-name=\"brand name text\">EcoTrade</span>\n</div>\n<nav class=\"flex flex-col gap-2\" data-kid=\"2-1-2\" data-name=\"navigation menu links\">\n<div class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--color-slate)]/40 mb-2 px-4\" data-kid=\"2-1-2-1\" data-name=\"menu section label\">Menu</div>\n<a class=\"flex items-center gap-3 px-4 py-3 bg-[var(--color-moss)]/5 text-[var(--color-moss)] rounded-2xl font-semibold\" data-kid=\"2-1-2-2\" data-name=\"dashboard menu link\" href=\"#\">\n<i class=\"ti ti-dashboard text-lg\" data-kid=\"2-1-2-2-1\" data-name=\"dashboard icon\"></i>\n<span data-kid=\"2-1-2-2-2\" data-name=\"dashboard link text\">Dashboard</span>\n</a>\n<a class=\"flex items-center gap-3 px-4 py-3 text-[var(--color-slate)]/60 hover:text-[var(--color-moss)] hover:bg-[var(--color-moss)]/5 rounded-2xl transition-all\" data-kid=\"2-1-2-3\" data-name=\"users menu link\" href=\"#\">\n<i class=\"ti ti-users text-lg\" data-kid=\"2-1-2-3-1\" data-name=\"users icon\"></i>\n<span data-kid=\"2-1-2-3-2\" data-name=\"users link text\">Người dùng</span>\n</a>\n<a class=\"flex items-center gap-3 px-4 py-3 text-[var(--color-slate)]/60 hover:text-[var(--color-moss)] hover:bg-[var(--color-moss)]/5 rounded-2xl transition-all\" data-kid=\"2-1-2-4\" data-name=\"products menu link\" href=\"#\">\n<i class=\"ti ti-package text-lg\" data-kid=\"2-1-2-4-1\" data-name=\"products icon\"></i>\n<span data-kid=\"2-1-2-4-2\" data-name=\"products link text\">Sản phẩm</span>\n</a>\n<a class=\"flex items-center gap-3 px-4 py-3 text-[var(--color-slate)]/60 hover:text-[var(--color-moss)] hover:bg-[var(--color-moss)]/5 rounded-2xl transition-all\" data-kid=\"2-1-2-5\" data-name=\"orders menu link\" href=\"#\">\n<i class=\"ti ti-receipt text-lg\" data-kid=\"2-1-2-5-1\" data-name=\"orders icon\"></i>\n<span data-kid=\"2-1-2-5-2\" data-name=\"orders link text\">Đơn hàng</span>\n</a>\n<a class=\"flex items-center gap-3 px-4 py-3 text-[var(--color-slate)]/60 hover:text-[var(--color-moss)] hover:bg-[var(--color-moss)]/5 rounded-2xl transition-all\" data-kid=\"2-1-2-6\" data-name=\"reports menu link\" href=\"#\">\n<i class=\"ti ti-report text-lg\" data-kid=\"2-1-2-6-1\" data-name=\"reports icon\"></i>\n<span data-kid=\"2-1-2-6-2\" data-name=\"reports link text\">Báo cáo</span>\n</a>\n<div class=\"mt-8 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--color-slate)]/40 mb-2 px-4\" data-kid=\"2-1-2-7\" data-name=\"system section label\">Hệ thống</div>\n<a class=\"flex items-center gap-3 px-4 py-3 text-[var(--color-slate)]/60 hover:text-[var(--color-moss)] hover:bg-[var(--color-moss)]/5 rounded-2xl transition-all\" data-kid=\"2-1-2-8\" data-name=\"settings menu link\" href=\"#\">\n<i class=\"ti ti-settings text-lg\" data-kid=\"2-1-2-8-1\" data-name=\"settings icon\"></i>\n<span data-kid=\"2-1-2-8-2\" data-name=\"settings link text\">Cài đặt</span>\n</a>\n</nav>\n<div class=\"mt-auto p-4 rounded-3xl bg-[var(--color-moss)] text-white relative overflow-hidden\" data-kid=\"2-1-3\" data-name=\"live status card\">\n<div class=\"relative z-10\" data-kid=\"2-1-3-1\" data-name=\"live status information\">\n<p class=\"text-[10px] font-bold uppercase tracking-widest opacity-70 mb-1\" data-kid=\"2-1-3-1-1\" data-name=\"live status label\">Dữ liệu thực tế</p>\n<p class=\"text-sm font-medium mb-3\" data-kid=\"2-1-3-1-2\" data-name=\"system status description\">Hệ thống đang hoạt động tốt</p>\n<div class=\"flex items-center gap-2\" data-kid=\"2-1-3-1-3\" data-name=\"live indicator container\">\n<div class=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" data-kid=\"2-1-3-1-3-1\" data-name=\"pulsing live indicator dot\"></div>\n<span class=\"text-xs\" data-kid=\"2-1-3-1-3-2\" data-name=\"live status text\">Live Update</span>\n</div>\n</div>\n<i class=\"ti ti-leaf-2 absolute -right-4 -bottom-4 text-7xl opacity-10 rotate-12 animate-leaf\" data-kid=\"2-1-3-2\" data-name=\"animated leaf background icon\"></i>\n</div>\n</aside>\n\n<main class=\"ml-72 flex-1 p-10\" data-kid=\"2-2\" data-name=\"main content area\">\n\n<header class=\"flex justify-between items-start mb-10\" data-kid=\"2-2-1\" data-name=\"header container\">\n<div data-kid=\"2-2-1-1\" data-name=\"page title and description container\">\n<h1 class=\"text-3xl font-black mb-1\" data-kid=\"2-2-1-1-1\" data-name=\"page title\">Trang quản trị</h1>\n<p class=\"text-[var(--color-slate)]/50 font-medium\" data-kid=\"2-2-1-1-2\" data-name=\"page description text\">Tổng quan dữ liệu hoạt động thực tế của toàn hệ thống.</p>\n</div>\n<div class=\"flex gap-4\" data-kid=\"2-2-1-2\" data-name=\"header action buttons container\">\n<button class=\"flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-white border border-[var(--color-moss)]/10 text-sm font-semibold hover:bg-gray-50 transition-all\" data-kid=\"2-2-1-2-1\" data-name=\"date selector button\">\n<i class=\"ti ti-calendar\" data-kid=\"2-2-1-2-1-1\" data-name=\"calendar icon\"></i>\n          14 Tháng 7, 2026\n        </button>\n<button class=\"flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-[var(--color-moss)] text-white text-sm font-bold shadow-sm hover:opacity-90 transition-all\" data-kid=\"2-2-1-2-2\" data-name=\"export report button\">\n<i class=\"ti ti-download\" data-kid=\"2-2-1-2-2-1\" data-name=\"download icon\"></i>\n          Xuất báo cáo\n        </button>\n</div>\n</header>\n\n<section class=\"bg-[var(--color-warm-white)] rounded-[40px] border border-[var(--color-moss)]/5 shadow-[0_20px_50px_rgba(42,90,59,0.04)] mb-10 p-1\" data-kid=\"2-2-2\" data-name=\"metrics section container\">\n<div class=\"grid grid-cols-3 divide-x divide-[var(--color-moss)]/5\" data-kid=\"2-2-2-1\" data-name=\"metrics grid container\">\n\n<div class=\"p-10\" data-kid=\"2-2-2-1-1\" data-name=\"people metrics column\">\n<div class=\"flex items-center gap-2 mb-8\" data-kid=\"2-2-2-1-1-1\" data-name=\"people label container\">\n<i class=\"ti ti-users text-[var(--color-moss)] text-xl\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"people icon\"></i>\n<span class=\"text-[10px] font-bold uppercase tracking-[0.25em] text-[var(--color-slate)]/40\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"people label text\">People</span>\n</div>\n<div class=\"flex flex-col gap-1 mb-8\" data-kid=\"2-2-2-1-1-2\" data-name=\"total users container\">\n<span class=\"text-5xl font-black tracking-tighter\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"total users count\">12,840</span>\n<span class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--color-moss)]\" data-kid=\"2-2-2-1-1-2-2\" data-name=\"total users label\">Tổng người dùng</span>\n</div>\n<div class=\"flex flex-col gap-6 pt-6 border-t border-[var(--color-moss)]/5\" data-kid=\"2-2-2-1-1-3\" data-name=\"people secondary metrics list\">\n<div class=\"flex justify-between items-end\" data-kid=\"2-2-2-1-1-3-1\" data-name=\"KYC pending metric item\">\n<div data-kid=\"2-2-2-1-1-3-1-1\" data-name=\"KYC pending label\">\n<p class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--color-slate)]/40 mb-1\" data-kid=\"2-2-2-1-1-3-1-1-1\" data-name=\"KYC pending title\">Chờ xác minh KYC</p>\n<p class=\"text-2xl font-black text-[var(--color-terracotta)]\" data-kid=\"2-2-2-1-1-3-1-1-2\" data-name=\"KYC pending value\">45</p>\n</div>\n<div class=\"text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-lg\" data-kid=\"2-2-2-1-1-3-1-2\" data-name=\"KYC growth percentage\">+12%</div>\n</div>\n<div class=\"flex justify-between items-end\" data-kid=\"2-2-2-1-1-3-2\" data-name=\"locked accounts metric item\">\n<div data-kid=\"2-2-2-1-1-3-2-1\" data-name=\"locked accounts label\">\n<p class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--color-slate)]/40 mb-1\" data-kid=\"2-2-2-1-1-3-2-1-1\" data-name=\"locked accounts title\">Tài khoản bị khóa</p>\n<p class=\"text-2xl font-black opacity-40\" data-kid=\"2-2-2-1-1-3-2-1-2\" data-name=\"locked accounts value\">128</p>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"p-10\" data-kid=\"2-2-2-1-2\" data-name=\"goods metrics column\">\n<div class=\"flex items-center gap-2 mb-8\" data-kid=\"2-2-2-1-2-1\" data-name=\"goods label container\">\n<i class=\"ti ti-package text-[var(--color-moss)] text-xl\" data-kid=\"2-2-2-1-2