      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-primary: #2A5A3B;\n    --color-secondary: #E07A5F;\n    --color-bg-sage: #F4F9F5;\n    --color-surface: #FDFDFD;\n    --color-text-slate: #1B2623;\n    --color-text-muted: #5A6B65;\n    --color-status-new: #F59E0B;\n    --color-status-transit: #3B82F6;\n    --color-status-done: #10B981;\n  }\n\n  body {\n    background-color: var(--color-bg-sage);\n    color: var(--color-text-slate);\n    font-family: 'Be Vietnam Pro', sans-serif;\n    margin: 0;\n  }\n\n  .dashed-divider {\n    background-image: linear-gradient(to bottom, #D1D5DB 50%, rgba(255, 255, 255, 0) 0%);\n    background-position: center;\n    background-size: 1px 12px;\n    background-repeat: repeat-y;\n  }\n\n  .horizontal-dashed-divider {\n    background-image: linear-gradient(to right, #D1D5DB 50%, rgba(255, 255, 255, 0) 0%);\n    background-position: center;\n    background-size: 12px 1px;\n    background-repeat: repeat-x;\n  }\n\n  .slide-action {\n    position: relative;\n    width: 100%;\n    height: 56px;\n    background: #f1f5f3;\n    border-radius: 28px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    user-select: none;\n    cursor: grab;\n  }\n\n  .slide-handle {\n    position: absolute;\n    left: 4px;\n    top: 4px;\n    bottom: 4px;\n    width: 48px;\n    background: var(--color-primary);\n    border-radius: 24px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: white;\n    z-index: 2;\n    transition: transform 0.1s ease-out;\n  }\n\n  .slide-text {\n    font-size: 14px;\n    font-weight: 600;\n    color: var(--color-text-muted);\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  .journey-line {\n    position: relative;\n  }\n\n  .journey-line::before {\n    content: '';\n    position: absolute;\n    left: 7px;\n    top: 20px;\n    bottom: 20px;\n    width: 1px;\n    border-left: 1.5px dashed #D1D5DB;\n  }\n\n  .animate-blob {\n    animation: blob 7s infinite;\n  }\n\n  @keyframes blob {\n    0% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }\n    50% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }\n    100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }\n  }\n</style>\n<div class=\"flex min-h-screen\" data-kid=\"1\">\n\n<aside class=\"w-64 bg-white border-r border-gray-100 flex flex-col p-6 sticky top-0 h-screen\" data-kid=\"1-1\">\n<div class=\"flex items-center gap-2 mb-10\" data-kid=\"1-1-1\">\n<div class=\"w-8 h-8 bg-[var(--color-primary)] rounded-lg flex items-center justify-center text-white\" data-kid=\"1-1-1-1\">\n<i class=\"ti ti-leaf text-xl\" data-kid=\"1-1-1-1-1\"></i>\n</div>\n<span class=\"text-xl font-bold tracking-tight text-[var(--color-primary)]\" data-kid=\"1-1-1-2\">EcoTrade</span>\n</div>\n<nav class=\"flex-1 space-y-2\" data-kid=\"1-1-2\">\n<a class=\"flex items-center gap-3 px-4 py-3 bg-[var(--color-primary)] text-white rounded-2xl shadow-sm transition-all\" data-kid=\"1-1-2-1\" href=\"#\">\n<i class=\"ti ti-smart-home text-lg\" data-kid=\"1-1-2-1-1\"></i>\n<span class=\"font-semibold text-sm\" data-kid=\"1-1-2-1-2\">Dashboard</span>\n</a>\n<a class=\"flex items-center gap-3 px-4 py-3 text-[var(--color-text-muted)] hover:bg-gray-50 rounded-2xl transition-all\" data-kid=\"1-1-2-2\" href=\"#\">\n<i class=\"ti ti-package text-lg\" data-kid=\"1-1-2-2-1\"></i>\n<span class=\"font-medium text-sm\" data-kid=\"1-1-2-2-2\">Đơn hàng</span>\n</a>\n<a class=\"flex items-center gap-3 px-4 py-3 text-[var(--color-text-muted)] hover:bg-gray-50 rounded-2xl transition-all\" data-kid=\"1-1-2-3\" href=\"#\">\n<i class=\"ti ti-wallet text-lg\" data-kid=\"1-1-2-3-1\"></i>\n<span class=\"font-medium text-sm\" data-kid=\"1-1-2-3-2\">Ví thu nhập</span>\n</a>\n<a class=\"flex items-center gap-3 px-4 py-3 text-[var(--color-text-muted)] hover:bg-gray-50 rounded-2xl transition-all\" data-kid=\"1-1-2-4\" href=\"#\">\n<i class=\"ti ti-history text-lg\" data-kid=\"1-1-2-4-1\"></i>\n<span class=\"font-medium text-sm\" data-kid=\"1-1-2-4-2\">Lịch sử</span>\n</a>\n</nav>\n<div class=\"mt-auto pt-6 border-t border-gray-100\" data-kid=\"1-1-3\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-3-1\">\n<img alt=\"Avatar\" class=\"w-10 h-10 rounded-full object-cover\" data-kid=\"1-1-3-1-1\" src=\"https://i.pravatar.cc/100?u=shipper1\">\n<div data-kid=\"1-1-3-1-2\">\n<p class=\"text-sm font-bold leading-tight\" data-kid=\"1-1-3-1-2-1\">Trần Văn Giao</p>\n<p class=\"text-[10px] text-[var(--color-text-muted)] uppercase tracking-wider font-semibold\" data-kid=\"1-1-3-1-2-2\">Shipper đối tác</p>\n</div>\n</div>\n</div>\n</aside>\n\n<main class=\"flex-1 p-8 lg:p-12 overflow-y-auto\" data-kid=\"1-2\">\n\n<div class=\"flex justify-between items-center mb-8\" data-kid=\"1-2-1\">\n<div data-kid=\"1-2-1-1\">\n<h1 class=\"text-3xl font-extrabold tracking-tight\" data-kid=\"1-2-1-1-1\">Chào buổi sáng, Giao 👋</h1>\n<p class=\"text-[var(--color-text-muted)] mt-1 font-medium\" data-kid=\"1-2-1-1-2\">Bạn đã sẵn sàng cho hành trình xanh hôm nay chưa?</p>\n</div>\n<div class=\"flex items-center gap-2 px-4 py-2 bg-white border border-green-100 rounded-full shadow-sm\" data-kid=\"1-2-1-2\">\n<span class=\"relative flex h-2 w-2\" data-kid=\"1-2-1-2-1\">\n<span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75\" data-kid=\"1-2-1-2-1-1\"></span>\n<span class=\"relative inline-flex rounded-full h-2 w-2 bg-green-500\" data-kid=\"1-2-1-2-1-2\"></span>\n</span>\n<span class=\"text-xs font-bold text-green-700 uppercase tracking-wider\" data-kid=\"1-2-1-2-2\">Online &amp; Ready</span>\n</div>\n</div>\n\n<section class=\"bg-[var(--color-surface)] rounded-[32px] p-8 shadow-[0px_10px_40px_rgba(42,90,59,0.06)] border border-green-50/50 mb-12\" data-kid=\"1-2-2\">\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-0\" data-kid=\"1-2-2-1\">\n<div class=\"flex flex-col p-4\" data-kid=\"1-2-2-1-1\">\n<p class=\"text-[11px] font-bold text-[var(--color-text-muted)] uppercase tracking-[0.2em] mb-3\" data-kid=\"1-2-2-1-1-1\">Tổng thu nhập</p>\n<div class=\"flex items-end gap-1\" data-kid=\"1-2-2-1-1-2\">\n<span class=\"text-3xl font-black\" data-kid=\"1-2-2-1-1-2-1\">1.250.000</span>\n<span class=\"text-lg font-bold text-[var(--color-primary)] mb-1\" data-kid=\"1-2-2-1-1-2-2\">đ</span>\n</div>\n<p class=\"text-[10px] text-green-600 font-bold mt-2 flex items-center gap-1\" data-kid=\"1-2-2-1-1-3\">\n<i class=\"ti ti-trending-up\" data-kid=\"1-2-2-1-1-3-1\"></i> +12% so với hôm qua\n          </p>\n</div>\n<div class=\"flex flex-col p-4 border-l-0 md:border-l border-dashed border-gray-200\" data-kid=\"1-2-2-1-2\">\n<p class=\"text-[11px] font-bold text-[var(--color-text-muted)] uppercase tracking-[0.2em] mb-3\" data-kid=\"1-2-2-1-2-1\">Hoàn thành</p>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-2\">\n<span class=\"text-3xl font-black\" data-kid=\"1-2-2-1-2-2-1\">18</span>\n<span class=\"px-2 py-0.5 bg-green-50 text-[var(--color-primary)] text-[10px] font-bold rounded-lg\" data-kid=\"1-2-2-1-2-2-2\">Target: 25</span>\n</div>\n<div class=\"mt-4 h-1.5 w-full bg-gray-100 rounded-full overflow-hidden\" data-kid=\"1-2-2-1-2-3\">\n<div class=\"h-full bg-[var(--color-primary)] rounded-full\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"progress bar fill\" data-reason=\"width updated by script to reflect progress\" style=\"width: 72%\"></div>\n</div>\n</div>\n<div class=\"flex flex-col p-4 border-l-0 md:border-l border-dashed border-gray-200\" data-kid=\"1-2-2-1-3\">\n<p class=\"text-[11px] font-bold text-[var(--color-text-muted)] uppercase tracking-[0.2em] mb-3\" data-kid=\"1-2-2-1-3-1\">Chờ xử lý</p>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-3-2\">\n<span class=\"text-3xl font-black\" data-kid=\"1-2-2-1-3-2-1\">04</span>\n<div class=\"flex -space-x-2\" data-kid=\"1-2-2-1-3-2-2\">\n<div class=\"w-6 h-6 rounded-full border-2 border-white bg-amber-400\" data-kid=\"1-2-2-1-3-2-2-1\"></div>\n<div class=\"w-6 h-6 rounded-full border-2 border-white bg-blue-400\" data-kid=\"1-2-2-1-3-2-2-2\"></div>\n</div>\n</div>\n<p class=\"text-[10px] text-[var(--color-text-muted)] font-medium mt-2\" data-kid=\"1-2-2-1-3-3\">Đang có 2 đơn mới chờ bạn nhận.</p>\n</div>\n</div>\n</section>\n\n<div class=\"flex flex-col md:flex-row gap-12\" data-kid=\"1-2-3\">\n<div class=\"flex-1\" data-kid=\"1-2-3-1\">\n<div class=\"flex items-center justify-between mb-8\" data-kid=\"1-2-3-1-1\">\n<h2 class=\"text-xl font-extrabold tracking-tight\" data-kid=\"1-2-3-1-1-1\">Hành trình hôm nay</h2>\n<div class=\"flex gap-1 p-1 bg-white rounded-xl shadow-sm border border-gray-50\" data-kid=\"1-2-3-1-1-2\">\n<button class=\"px-4 py-1.5 text-xs font-bold rounded-lg bg-[var(--color-primary)] text-white shadow-sm transition-all\" data-kid=\"1-2-3-1-1-2-1\">Tất cả</button>\n<button class=\"px-4 py-1.5 text-xs font-bold rounded-lg text-[var(--color-text-muted)] hover:bg-gray-50 transition-all\" data-kid=\"1-2-3-1-1-2-2\">Mới</button>\n<button class=\"px-4 py-1.5 text-xs font-bold rounded-lg text-[var(--color-text-muted)] hover:bg-gray-50 transition-all\" data-kid=\"1-2-3-1-1-2-3\">Đang giao</button>\n</div>\n</div>\n\n<div class=\"relative pl-10 space-y-12\" data-kid=\"1-2-3-1-2\">\n\n<div class=\"absolute left-[19px] top-4 bottom-4 w-0.5 dashed-divider\" data-kid=\"1-2-3-1-2-1\"></div>\n\n<div class=\"relative\" data-kid=\"1-2-3-1-2-2\">\n\n<div class=\"absolute -left-10 top-0 w-10 h-10 rounded-full bg-blue-50 border-2 border-blue-500 flex items-center justify-center text-blue-600 z-10 shadow-[0_0_15px_rgba(59,130,246,0.3)]\" data-kid=\"1-2-3-1-2-2-1\">\n<i class=\"ti ti-truck text-lg\" data-kid=\"1-2-3-1-2-2-1-1\"></i>\n</div>\n\n<div class=\"bg-white rounded-[28px] p-6 shadow-sm border border-gray-50/50 hover:shadow-md transition-shadow\" data-kid=\"1-2-3-1-2-2-2\">\n<div class=\"flex justify-between items-start mb-6\" data-kid=\"1-2-3-1-2-2-2-1\">\n<div data-kid=\"1-2-3-1-2-2-2-1-1\">\n<span class=\"text-[10px] font-bold text-blue-600 uppercase tracking-widest bg-blue-50 px-2 py-0.5 rounded-md\" data-kid=\"1-2-3-1-2-2-2-1-1-1\">Đang giao</span>\n<h3 class=\"text-lg font-extrabold mt-2\" data-kid=\"1-2-3-1-2-2-2-1-1-2\">Máy ảnh Fujifilm X-T30</h3>\n</div>\n<div class=\"text-right\" data-kid=\"1-2-3-1-2-2-2-1-2\">\n<p class=\"text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider\" data-kid=\"1-2-3-1-2-2-2-1-2-1\">Mã vận đơn</p>\n<p class=\"text-sm font-black text-[var(--color-primary)]\" data-kid=\"1-2-3-1-2-2-2-1-2-2\">#ECO98231</p>\n</div>\n</div>\n\n<div class=\"journey-line space-y-4 mb-8\" data-kid=\"1-2-3-1-2-2-2-2\">\n<div class=\"flex items-start gap-4\" data-kid=\"1-2-3-1-2-2-2-2-1\">\n<div class=\"w-4 h-4 rounded-full bg-[var(--color-primary)] mt-1 flex-shrink-0\" data-kid=\"1-2-3-1-2-2-2-2-1-1\"></div>\n<div data-kid=\"1-2-3-1-2-2-2-2-1-2\">\n<p class=\"text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider\" data-kid=\"1-2-3-1-2-2-2-2-1-2-1\">Điểm lấy hàng</p>\n<p class=\"text-sm font-semibold\" data-kid=\"1-2-3-1-2-2-2-2-1-2-2\">Cửa hàng đồ cũ Vintage, 42 Trần Hưng Đạo, Hoàn Kiếm, HN</p>\n</div>\n</div>\n<div class=\"flex items-start gap-4\" data-kid=\"1-2-3-1-2-2-2-2-2\">\n<div class=\"w-4 h-4 rounded-full border-2 border-gray-300 mt-1 flex-shrink-0 bg-white\" data-kid=\"1-2-3-1-2-2-2-2-2-1\"></div>\n<div data-kid=\"1-2-3-1-2-2-2-2-2-2\">\n<p class=\"text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider\" data-kid=\"1-2-3-1-2-2-2-2-2-2-1\">Điểm giao hàng</p>\n<p class=\"text-sm font-semibold\" data-kid=\"1-2-3-1-2-2-2-2-2-2-2\">Tòa nhà Landmark 81, P. 22, Q. Bình Thạnh, TP. HCM</p>\n</div>\n</div>\n</div>\n<div class=\"flex items-center justify-between pt-6 border-t border-gray-50\" data-kid=\"1-2-3-1-2-2-2-3\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-2-2-3-1\">\n<div class=\"w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center text-gray-500\" data-kid=\"1-2-3-1-2-2-2-3-1-1\">\n<i class=\"ti ti-wallet\" data-kid=\"1-2-3-1-2-2-2-3-1-1-1\"></i>\n</div>\n<div data-kid=\"1-2-3-1-2-2-2-3-1-2\">\n<p class=\"text-[10px] font-bold text-[var(--color-text-muted)] uppercase\" data-kid=\"1-2-3-1-2-2-2-3-1-2-1\">Phí giao</p>\n<p class=\"text-sm font-black text-green-600\" data-kid=\"1-2-3-1-2-2-2-3-1-2-2\">45.000 đ</p>\n</div>\n</div>\n<button class=\"px-6 py-2.5 bg-white border border-gray-200 rounded-2xl text-xs font-bold hover:bg-gray-50 transition-all\" data-kid=\"1-2-3-1-2-2-2-3-2\">Chi tiết đơn</button>\n</div>\n</div>\n</div>\n\n<div class=\"relative\" data-kid=\"1-2-3-1-2-3\">\n\n<div class=\"absolute -left-10 top-0 w-10 h-10 rounded-full bg-amber-50 border-2 border-amber-500 flex items-center justify-center text-amber-600 z-10 shadow-[0_0_15px_rgba(245,158,11,0.3)]\" data-kid=\"1-2-3-1-2-3-1\">\n<i class=\"ti ti-bell text-lg\" data-kid=\"1-2-3-1-2-3-1-1\"></i>\n</div>\n\n<div class=\"bg-white rounded-[28px] p-6 shadow-sm border border-gray-50/50 hover:shadow-md transition-shadow\" data-kid=\"1-2-3-1-2-3-2\">\n<div class=\"flex justify-between items-start mb-6\" data-kid=\"1-2-3-1-2-3-2-1\">\n<div data-kid=\"1-2-3-1-2-3-2-1-1\">\n<span class=\"text-[10px] font-bold text-amber-600 uppercase tracking-widest bg-amber-50 px-2 py-0.5 rounded-md\" data-kid=\"1-2-3-1-2-3-2-1-1-1\">Đơn mới</span>\n<h3 class=\"text-lg font-extrabold mt-2\" data-kid=\"1-2-3-1-2-3-2-1-1-2\">Bàn phím cơ Keychron K2</h3>\n</div>\n<div class=\"text-right\" data-kid=\"1-2-3-1-2-3-2-1-2\">\n<p class=\"text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider\" data-kid=\"1-2-3-1-2-3-2-1-2-1\">Mã vận đơn</p>\n<p class=\"text-sm font-black text-[var(--color-primary)]\" data-kid=\"1-2-3-1-2-3-2-1-2-2\">#ECO98442</p>\n</div>\n</div>\n<div class=\"journey-line space-y-4 mb-8 opacity-60\" data-kid=\"1-2-3-1-2-3-2-2\">\n<div class=\"flex items-start gap-4\" data-kid=\"1-2-3-1-2-3-2-2-1\">\n<div class=\"w-4 h-4 rounded-full bg-gray-300 mt-1 flex-shrink-0\" data-kid=\"1-2-3-1-2-3-2-2-1-1\"></div>\n<div data-kid=\"1-2-3-1-2-3-2-2-1-2\">\n<p class=\"text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider\" data-kid=\"1-2-3-1-2-3-2-2-1-2-1\">Điểm lấy hàng</p>\n<p class=\"text-sm font-semibold italic\" data-kid=\"1-2-3-1-2-3-2-2-1-2-2\">Hidden for privacy</p>\n</div>\n</div>\n<div class=\"flex items-start gap-4\" data-kid=\"1-2-3-1-2-3-2-2-2\">\n<div class=\"w-4 h-4 rounded-full border-2 border-gray-300 mt-1 flex-shrink-0 bg-white\" data-kid=\"1-2-3-1-2-3-2-2-2-1\"></div>\n<div data-kid=\"1-2-3-1-2-3-2-2-2-2\">\n<p class=\"text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider\" data-kid=\"1-2-3-1-2-3-2-2-2-2-1\">Điểm giao hàng</p>\n<p class=\"text-sm font-semibold italic\" data-kid=\"1-2-3-1-2-3-2-2-2-2-2\">Hidden for privacy</p>\n</div>\n</div>\n</div>\n<div class=\"slide-action\" data-kid=\"1-2-3-1-2-3-2-3\" data-name=\"slide to accept interaction container\" id=\"accept-slide\">\n<div class=\"slide-handle\" data-kid=\"1-2-3-1-2-3-2-3-1\" data-name=\"slide handle\">\n<i class=\"ti ti-chevron-right text-lg\" data-kid=\"1-2-3-1-2-3-2-3-1-1\" data-name=\"chevron right icon\"></i>\n</div>\n<span class=\"slide-text\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-3-2-3-2\" data-name=\"slide action text\" data-reason=\"text content replaced by script on successful interaction\">Trượt để nhận đơn (35.000 đ)</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"w-full md:w-80 space-y-8\" data-kid=\"1-2-3-2\">\n<div class=\"bg-[var(--color-primary)] rounded-[32px] p-6 text-white relative overflow-hidden\" data-kid=\"1-2-3-2-1\">\n\n<div class=\"absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 animate-blob\" data-kid=\"1-2-3-2-1-1\"></div>\n<h4 class=\"text-sm font-bold uppercase tracking-widest mb-4 opacity-80\" data-kid=\"1-2-3-2-1-2\">Thông tin khu vực</h4>\n<div class=\"space-y-4 relative z-10\" data-kid=\"1-2-3-2-1-3\">\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-3-2-1-3-1\">\n<div class=\"w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center\" data-kid=\"1-2-3-2-1-3-1-1\">\n<i class=\"ti ti-map-2 text-xl\" data-kid=\"1-2-3-2-1-3-1-1-1\"></i>\n</div>\n<div data-kid=\"1-2-3-2-1-3-1-2\">\n<p class=\"text-[10px] font-bold opacity-70 uppercase\" data-kid=\"1-2-3-2-1-3-1-2-1\">Khu vực hoạt động</p>\n<p class=\"text-sm font-semibold\" data-kid=\"1-2-3-2-1-3-1-2-2\">Quận Hoàn Kiếm, HN</p>\n</div>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-3-2-1-3-2\">\n<div class=\"w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center\" data-kid=\"1-2-3-2-1-3-2-1\">\n<i class=\"ti ti-cloud-rain text-xl\" data-kid=\"1-2-3-2-1-3-2-1-1\"></i>\n</div>\n<div data-kid=\"1-2-3-2-1-3-2-2\">\n<p class=\"text-[10px] font-bold opacity-70 uppercase\" data-kid=\"1-2-3-2-1-3-2-2-1\">Thời tiết</p>\n<p class=\"text-sm font-semibold\" data-kid=\"1-2-3-2-1-3-2-2-2\">Mưa nhẹ, 24°C</p>\n</div>\n</div>\n</div>\n<button class=\"w-full mt-8 py-3 bg-white text-[var(--color-primary)] rounded-2xl text-xs font-black shadow-lg hover:scale-105 transition-all\" data-kid=\"1-2-3-2-1-4\">Xem bản đồ nhiệt</button>\n</div>\n<div class=\"bg-white rounded-[32px] p-6 border border-gray-50 shadow-sm\" data-kid=\"1-2-3-2-2\">\n<h4 class=\"text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-6\" data-kid=\"1-2-3-2-2-1\">Mẹo bảo vệ môi trường</h4>\n<div class=\"flex gap-4\" data-kid=\"1-2-3-2-2-2\">\n<div class=\"w-10 h-10 rounded-full bg-green-50 flex-shrink-0 flex items-center justify-center text-[var(--color-primary)]\" data-kid=\"1-2-3-2-2-2-1\">\n<i class=\"ti ti-bike\" data-kid=\"1-2-3-2-2-2-1-1\"></i>\n</div>\n<p class=\"text-xs leading-relaxed font-medium\" data-kid=\"1-2-3-2-2-2-2\">Sử dụng xe đạp điện hoặc xe máy điện để giảm lượng khí thải CO2 trong quá trình giao hàng của bạn.</p>\n</div>\n</div>\n</div>\n</div>\n</main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"2\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/Draggable.min.js\" data-kid=\"3\"></script>\n<script data-kid=\"4\">\n  gsap.registerPlugin(Draggable);\n\n  const container = document.getElementById('accept-slide');\n  const handle = container.querySelector('.slide-handle');\n  const text = container.querySelector('.slide-text');\n  const maxWidth = container.offsetWidth - handle.offsetWidth - 8;\n\n  Draggable.create(handle, {\n    type: \"x\",\n    bounds: container,\n    edgeResistance: 0.65,\n    onDrag: function() {\n      // Fade out text as we slide\n      const progress = this.x / maxWidth;\n      text.style.opacity = 1 - progress * 1.5;\n    },\n    onRelease: function() {\n      if (this.x >= maxWidth - 10) {\n        // Confirmed\n        gsap.to(handle, { x: maxWidth, duration: 0.2 });\n        gsap.to(container, { backgroundColor: '#2A5A3B', duration: 0.3 });\n        text.innerText = \"Đã nhận đơn!\";\n        text.style.color = \"#ffffff\";\n        text.style.opacity = 1;\n        handle.innerHTML = '<i class=\"ti ti-check\"></i>';\n      } else {\n        // Back to start\n        gsap.to(handle, { x: 0, duration: 0.2 });\n        gsap.to(text, { opacity: 1, duration: 0.2 });\n      }\n    }\n  });\n</script>",
